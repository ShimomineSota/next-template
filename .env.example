# Canonical env-var list for this project. Copy to .env.development /
# .env.staging / .env.production (or run `npm run env:init`), then encrypt with
# dotenvx (`npm run env:encrypt`). Every key here must exist in all three.
#
# NEXT_PUBLIC_* is inlined into the client bundle at build AND readable
# server-side via process.env.
NEXT_PUBLIC_ENVIRONMENT=development

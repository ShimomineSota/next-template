DOTENV_PUBLIC_KEY_DEVELOPMENT="0238399702fade97a70de6b13b7121a1171668a059fb86595dc2d049032ad415de"

# .env.development
# Per-environment config, dotenvx-encrypted and committed (`npm run env:encrypt`).
# .env.keys stays gitignored. Keep the SAME keys across all three files;
# values differ, key set does not. NEXT_PUBLIC_* is readable client- and server-side.
NEXT_PUBLIC_ENVIRONMENT=encrypted:BDiW59AMywKUyu+n6YturmsO1XzswfGlXDFGZ7EnDOnYtSHXXQx1PRJru4Ironr8em1CQC13GeZEU8BHv0jUpBqI1C2f+g1ZkqG6P+L7PYyVZKnyLgFrSDN+WR6eB9WB6ggAsHzPJuVitJ5p

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "next-template",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "cache": {
    "enabled": true,
  },
  "images": {
    "binding": "IMAGES",
  },
  "kv_namespaces": [
    {
      "binding": "VINEXT_KV_CACHE",
      "id": "<your-kv-namespace-id>",
    },
  ],
  // `develop` deploys here (CLOUDFLARE_ENV=staging via `npm run deploy -- --env
  // staging`). Named environments are NOT merged with the top level, so this
  // block repeats name + kv_namespaces with staging-specific values.
  "env": {
    "staging": {
      "name": "next-template-staging",
      "kv_namespaces": [
        {
          "binding": "VINEXT_KV_CACHE",
          "id": "<your-staging-kv-namespace-id>",
        },
      ],
    },
  },
}
